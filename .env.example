# Azure OpenAI: one Foundry resource serves every model below
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployments. `--model <alias>` reads AZURE_OPENAI_DEPLOYMENT_<ALIAS>, e.g. `--model mini`
AZURE_OPENAI_DEPLOYMENT_LUNA=    # default for extraction and merge
AZURE_OPENAI_DEPLOYMENT_SOL=     # default judge
AZURE_OPENAI_DEPLOYMENT_MINI=    # optional: a weaker model for the failure-mode run (use --effort default)
