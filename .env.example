# Azure OpenAI (read by annual_report_reader/chat.py through langchain-openai)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployments: extraction and merge (ExtractionConfig, MergeConfig) and judge (JudgeConfig)
AZURE_OPENAI_DEPLOYMENT_LUNA=
AZURE_OPENAI_DEPLOYMENT_SOL=
# Optional alias: `--model candidate_2` reads AZURE_OPENAI_DEPLOYMENT_<ALIAS>, e.g. a weaker model for the failure-mode run
AZURE_OPENAI_DEPLOYMENT_CANDIDATE_2=
